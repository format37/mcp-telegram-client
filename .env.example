# telegram-client MCP — copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# .env is gitignored and must NEVER be committed: this repository is public.

# Telegram app credentials — my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# Your own numeric Telegram user id. The session must belong to it, and only it can approve.
TGC_OWNER_ID=

# A NEW bot from @BotFather, used only by this server (press Start in it once): the control bot.
# It carries send approvals (if on), /status /lock /unlock and the session-expiry alerts.
# No other program may poll it: Telegram hands each update to one poller only.
APPROVAL_BOT_TOKEN=

# Sending. true: every send waits for your tap in the control bot.
# false: the agent sends directly; each send is logged silently in the bot (TGC_NOTIFY_SENDS).
#TGC_SEND_APPROVAL=true
#TGC_NOTIFY_SENDS=true

# Bearer tokens for the MCP endpoint, comma-separated, 32+ chars each (one per client):
#   openssl rand -hex 24
MCP_TOKENS=

# --- optional ---------------------------------------------------------------------
# Transcript timestamps
#TZ=Asia/Tbilisi
# Let the MCP read and write Saved Messages (off: many people keep secrets there)
#TGC_ALLOW_SAVED_MESSAGES=false
# Let the MCP send to Saved Messages (peer "me") while reading, searching and listing them stays off
#TGC_SEND_TO_SAVED_MESSAGES=false
# Extra chats the MCP must never touch: comma-separated ids as list_dialogs prints them
#TGC_DENY_PEERS=
# Tell you through the approval bot about every read, not just sends
#TGC_NOTIFY_READS=false
# Draft lifetime, and how long send_message waits for your tap before returning
#APPROVAL_TTL_MIN=30
#APPROVAL_WAIT_S=75
# Send budget (same defaults as the telegram-client skill)
#SEND_MIN_INTERVAL_S=5
#SEND_PER_HOUR=20
#SEND_PER_DAY=60
#SEND_NEW_PEERS_PER_DAY=3
# Largest file get_media downloads
#MAX_MEDIA_MB=20
# Files for send_message. Agents upload with curl to <TGC_PUBLIC_URL>/upload/<ticket>/<name>.
# Public base URL; default https://<first host in MCP_ALLOWED_HOSTS>/telegram-client
#TGC_PUBLIC_URL=
# Largest upload, and the most kept at once in the tgc-data volume
#MAX_UPLOAD_MB=100
#UPLOAD_STORE_MB=1000
# How long an upload is kept, and how long an upload link stays valid
#UPLOAD_TTL_MIN=120
#UPLOAD_LINK_TTL_MIN=15
# Longest caption in characters of visible text (Telegram Premium allows 4096); longer text
# goes out as its own message before the files
#CAPTION_MAX=1024
# Name in Telegram → Settings → Devices
#DEVICE_MODEL=telegram-client MCP
#LOG_LEVEL=INFO
