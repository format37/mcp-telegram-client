# telegram-client MCP — copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# .env is gitignored and must NEVER be committed: this repository is public.

# Telegram app credentials — my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# Your own numeric Telegram user id. The session must belong to it, and only it can approve.
TGC_OWNER_ID=

# A NEW bot from @BotFather, used only by this server (press Start in it once).
# It carries send approvals, /status /lock /unlock and the session-expiry alerts.
# No other program may poll it: Telegram hands each update to one poller only.
APPROVAL_BOT_TOKEN=

# Bearer tokens for the MCP endpoint, comma-separated, 32+ chars each (one per client):
#   openssl rand -hex 24
MCP_TOKENS=

# --- optional ---------------------------------------------------------------------
# Transcript timestamps
#TZ=Asia/Tbilisi
# Let the MCP read and write Saved Messages (off: many people keep secrets there)
#TGC_ALLOW_SAVED_MESSAGES=false
# Extra chats the MCP must never touch: comma-separated ids as list_dialogs prints them
#TGC_DENY_PEERS=
# Tell you through the approval bot about every read, not just sends
#TGC_NOTIFY_READS=false
# Draft lifetime, and how long send_message waits for your tap before returning
#APPROVAL_TTL_MIN=30
#APPROVAL_WAIT_S=75
# Send budget (same defaults as the telegram-client skill)
#SEND_MIN_INTERVAL_S=5
#SEND_PER_HOUR=20
#SEND_PER_DAY=60
#SEND_NEW_PEERS_PER_DAY=3
# Largest file get_media downloads
#MAX_MEDIA_MB=20
# Name in Telegram → Settings → Devices
#DEVICE_MODEL=telegram-client MCP
#LOG_LEVEL=INFO
